{
  "name": "factory-template",
  "version": "0.1.0",
  "private": true,
  "description": "Starter for projects built through Paul's software pipeline",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "dev": "node --watch src/server.ts",
    "lint": "eslint . && tsc --noEmit",
    "test": "node --test \"src/**/*.test.ts\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "typescript": "~6.0",
    "typescript-eslint": "^8.71.2"
  }
}
